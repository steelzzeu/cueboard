{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cueboard",
  "version": "1.0.0",
  "identifier": "com.cueboard.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cueboard",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "center": true,
        "visible": true,
        "backgroundColor": "#1c1c1c",
        "dragDropEnabled": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Cueboard",
    "copyright": "Cueboard",
    "category": "Entertainment",
    "shortDescription": "A native soundboard for streamers and gamers",
    "longDescription": "Cueboard is a Windows desktop soundboard with global hotkeys, a persistent local library, and low-latency playback for livestreamers, creators and gamers.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
